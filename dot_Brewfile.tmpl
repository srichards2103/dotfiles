# ~/.Brewfile — rendered by chezmoi per machine role (role = "{{ .role }}").
#   server  → headless dev box: CLI toolchain, docker, agents. No GUI bloat.
#   desktop → everything, including GUI apps and personal software.
# Re-run manually any time with: brew bundle install --global

# Adopt apps that already exist in /Applications instead of failing,
# so this is safe to run on a machine where apps were installed manually.
cask_args adopt: true

tap "hashicorp/tap"
tap "localstack/tap"

# --- Core dev toolchain (all machines) ---
brew "awscli"
brew "chezmoi"
brew "cloc"
brew "cmake"
brew "doctl"
brew "fd"
brew "fish"
brew "fzf"
brew "gdk-pixbuf"
brew "gh"
brew "gitlab-ci-local"
brew "glab"
brew "gobject-introspection"
brew "graphviz"
brew "imagemagick"
brew "lazygit"
brew "libffi"
brew "llama.cpp"
brew "make"
brew "mas"
brew "neovim"
brew "node"
brew "node@22"
brew "pango"
brew "poppler"
brew "pyenv"
brew "pyenv-virtualenv"
brew "repomix"
brew "ripgrep"
brew "socat"
brew "tmux"
brew "tree"
brew "virtualenv"
brew "hashicorp/tap/terraform"
brew "localstack/tap/localstack-cli"

# --- Core casks: the dev workflow needs these even headless ---
cask "docker-desktop"
cask "tailscale"

# --- npm globals: AI agents + JS tooling (the point of the cloud box) ---
npm "@colbymchenry/codegraph"
npm "@fission-ai/openspec"
npm "@google/gemini-cli"
npm "@openai/codex"
npm "@playwright/cli"
npm "agent-browser"
npm "clawdbot"
npm "corepack"
npm "eas-cli"
npm "oh-my-codex"
npm "pnpm"
npm "repomix"
npm "yarn"

{{ if ne .role "server" -}}
