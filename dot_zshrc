  local root="$(git rev-parse --show-toplevel)"
  sed -i '' "s/^BOOTSTRAP_WSKIPS=.*/BOOTSTRAP_WSKIPS=True/" "$root/dev.env"
  sed -i '' "s/^RUN_MIGRATIONS=.*/RUN_MIGRATIONS=True/" "$root/dev.env"
  "$root/deploy/db_deploy_and_restore_fast.sh"
}
drstn() {
  local root="$(git rev-parse --show-toplevel)"
  sed -i '' "s/^BOOTSTRAP_WSKIPS=.*/BOOTSTRAP_WSKIPS=False/" "$root/dev.env"
  "$root/deploy/db_deploy_and_restore_fast.sh"
}

