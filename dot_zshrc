  local root="$(git rev-parse --show-toplevel)"
  local name=$(grep COMPOSE_PROJECT_NAME "$root/.worktree.env" 2>/dev/null | cut -d= -f2)
  local container="${name:-wasteos}-backend-1"
  docker logs "$container" --tail "${1:-100}" -f
